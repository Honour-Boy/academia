# Backend environment variables
# Actual values live in Doppler. Use `doppler run -- npm run dev` locally.
# This file lists variable NAMES only and is committed.

# Server
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Supabase (service role key — backend only, never expose to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Clerk (server-side verification)
CLERK_SECRET_KEY=

# Redis (optional — only if needed)
REDIS_URL=

# OpenRouter (LLM routing)
OPENROUTER_API_KEY=

# PostHog (server-side LLM analytics)
POSTHOG_KEY=
POSTHOG_HOST=

# Sentry (auto-populated via integration)
SENTRY_DSN=
