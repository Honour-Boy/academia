# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the client. Used only in server-side admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Backend ───────────────────────────────────────────────────────────────────
# Express API base URL. After Render deploy, set this to the Render service URL.
# Example: https://academia-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Academia"
NEXT_PUBLIC_SCHOOL_NAME="Your School Name"
